# The project's two XDS110 probes and their UART interfaces.
# Members of plugdev can use these devices, including from a background session.
# uaccess also grants access to the active local desktop user.
SUBSYSTEM=="usb", ATTR{idVendor}=="0451", ATTR{idProduct}=="bef3", ATTR{serial}=="LS4500Q0", MODE="0660", GROUP="plugdev", TAG+="uaccess"
SUBSYSTEM=="usb", ATTR{idVendor}=="0451", ATTR{idProduct}=="bef3", ATTR{serial}=="LS4500IY", MODE="0660", GROUP="plugdev", TAG+="uaccess"
SUBSYSTEM=="tty", ATTRS{idVendor}=="0451", ATTRS{idProduct}=="bef3", ATTRS{serial}=="LS4500Q0", MODE="0660", GROUP="plugdev", TAG+="uaccess"
SUBSYSTEM=="tty", ATTRS{idVendor}=="0451", ATTRS{idProduct}=="bef3", ATTRS{serial}=="LS4500IY", MODE="0660", GROUP="plugdev", TAG+="uaccess"

# XDS110 ROM firmware-update mode has no USB serial-number attribute.
# This identity is also used by other TI Stellaris ROM DFU devices.
SUBSYSTEM=="usb", ATTR{idVendor}=="1cbe", ATTR{idProduct}=="00ff", MODE="0660", GROUP="plugdev", TAG+="uaccess"
