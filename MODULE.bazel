module(
    name = "direct_line",
    version = "0.1.0",
)

bazel_dep(name = "platforms", version = "1.1.0")
bazel_dep(name = "bazel_skylib", version = "1.8.2")
bazel_dep(name = "rules_rust", version = "0.74.0")
bazel_dep(name = "rules_python", version = "1.7.0")
bazel_dep(name = "rules_shell", version = "0.6.1")
bazel_dep(name = "rules_cc", version = "0.2.17")
bazel_dep(name = "toolchains_arm_gnu", version = "1.1.0")
git_override(
    module_name = "toolchains_arm_gnu",
    commit = "6895733b87d3a75a40056b12c3d6628bc6945011",
    remote = "https://github.com/hexdae/toolchains_arm_gnu.git",
)

arm = use_extension("@toolchains_arm_gnu//:extensions.bzl", "arm_toolchain")
arm.arm_none_eabi(version = "13.2.1")
use_repo(arm, "arm_none_eabi_linux_x86_64")

register_toolchains("//tools/toolchains:all")

bazel_dep(name = "buildifier_prebuilt", version = "10.1.0", dev_dependency = True)
bazel_dep(name = "ruff_prebuilt", version = "0.16.0.1", dev_dependency = True)

rust = use_extension("@rules_rust//rust:extensions.bzl", "rust")
rust.toolchain(
    edition = "2024",
    extra_rustc_flags_triples = {
        "thumbv8m.main-none-eabihf": [
            "-Ctarget-cpu=cortex-m33",
            "-Cpanic=abort",
            "-Cdebuginfo=2",
            "-Cstrip=none",
        ],
    },
    extra_target_triples = ["thumbv8m.main-none-eabihf"],
    rustfmt_version = "1.90.0",
    versions = ["1.90.0"],
)
use_repo(rust, "rust_toolchains")

register_toolchains("@rust_toolchains//:all")

rust_host = use_extension("@rules_rust//rust:extensions.bzl", "rust_host_tools")
rust_host.host_tools(
    name = "direct_line_rust_tools",
    edition = "2024",
    rustfmt_version = "1.90.0",
    version = "1.90.0",
)
use_repo(rust_host, rust_host_tools = "direct_line_rust_tools")

python = use_extension("@rules_python//python/extensions:python.bzl", "python")
python.toolchain(python_version = "3.12")
use_repo(python, "python_3_12")

bazel_dep(name = "reg_def", version = "0.1.0")
git_override(
    module_name = "reg_def",
    commit = "9d2f6e1afbd9d144abd58e20e8c0566ec05cf656",
    remote = "https://github.com/agoessling/reg_def.git",
)

http_file = use_repo_rule("@bazel_tools//tools/build_defs/repo:http.bzl", "http_file")

http_file(
    name = "clang_format",
    executable = True,
    sha256 = "2e3ea58345e20a028b8c35aff964f74df14e4cd17e2d524a8efc1ba9eced7da2",
    url = "https://github.com/muttleyxd/clang-tools-static-binaries/releases/download/master-2da3e7b/clang-format-19_linux-amd64",
)

http_archive = use_repo_rule("@bazel_tools//tools/build_defs/repo:http.bzl", "http_archive")

http_archive(
    name = "ti_sdk",
    build_file = "//third_party/ti:sdk.BUILD.bazel",
    sha256 = "f35cb6818302e986af4dc39849ee2ab63684e1c66586d9e864fd11408ead10ed",
    strip_prefix = "simplelink-lowpower-f2-sdk-lpf2-8.33.00.16",
    url = "https://github.com/TexasInstruments/simplelink-lowpower-f2-sdk/archive/refs/tags/lpf2-8.33.00.16.tar.gz",
)

sysconfig_repository = use_repo_rule("//third_party/ti:repositories.bzl", "sysconfig_repository")

sysconfig_repository(name = "ti_sysconfig")
